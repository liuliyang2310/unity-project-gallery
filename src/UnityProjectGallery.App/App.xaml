<Application x:Class="UnityProjectGallery.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UnityProjectGallery.App.Converters"
             xmlns:views="clr-namespace:UnityProjectGallery.App.Views"
             xmlns:viewModels="clr-namespace:UnityProjectGallery.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:CoverBrushConverter x:Key="CoverBrush" />
            <converters:ImagePathConverter x:Key="ImagePath" />
            <converters:ProjectInitialConverter x:Key="ProjectInitial" />
            <converters:RelativeTimeConverter x:Key="RelativeTime" />
            <converters:StringVisibilityConverter x:Key="StringVisibility" />

            <DataTemplate DataType="{x:Type viewModels:GalleryViewModel}">
                <views:GalleryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ProjectDetailViewModel}">
                <views:ProjectDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
