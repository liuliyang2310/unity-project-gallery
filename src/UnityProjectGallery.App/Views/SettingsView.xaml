<UserControl x:Class="UnityProjectGallery.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,18,28,28"
              MaxWidth="1320"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 返回与页面标题 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        ToolTip="返回项目库">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   Style="{StaticResource Text.Icon}"
                                   FontSize="11"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="返回项目库" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1"
                        Padding="10,5"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DefaultVersionText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="管理本机 Unity Editor 的安装路径，并指定找不到对应版本时使用的默认启动版本。"
                           Margin="0,5,0,0"
                           Style="{StaticResource Text.PageSubtitle}" />
                <TextBlock Text="{Binding AppVersionText}"
                           Margin="0,4,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Unity Editor 管理 -->
            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Style="{StaticResource Border.SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Unity Editor 管理"
                                       Style="{StaticResource Text.SectionTitle}" />
                            <TextBlock Text="手动添加 Unity.exe 后会自动读取版本；同一版本可以保留多个安装路径。"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource ProgressBar.Scan}"
                                         IsIndeterminate="True"
                                         Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CleanupMissingCommand}"
                                    ToolTip="删除所有已失效的手动路径记录">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;"
                                               Style="{StaticResource Text.Icon}"
                                               FontSize="11"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="清理失效" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="重新检测本机 Unity Editor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               Style="{StaticResource Text.Icon}"
                                               FontSize="11"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="重新检测" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}"
                                    AutomationProperties.AutomationId="AddUnityEditor"
                                    Command="{Binding AddEditorCommand}"
                                    ToolTip="选择本机的 Unity.exe">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               Style="{StaticResource Text.Icon}"
                                               FontSize="11"
                                               Margin="0,0,7,0" />
                                    <TextBlock Text="添加 Unity.exe" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 表头 -->
                    <Border Grid.Row="2"
                            Margin="0,14,0,0"
                            Padding="0,0,0,8"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Unity 版本"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Editor 路径"
                                       Margin="14,0,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="状态"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="操作"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- 记录列表 -->
                    <ItemsControl Grid.Row="3"
                                  Margin="0,2,0,0"
                                  ItemsSource="{Binding Editors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,12"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 版本 -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="6,2"
                                                        Background="{StaticResource FavoriteSoftBrush}"
                                                        BorderBrush="{StaticResource FavoriteBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsDefaultVersion, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="默认"
                                                               FontSize="9"
                                                               Foreground="{StaticResource FavoriteBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourceText}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>

                                        <!-- 路径 -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EditorPath}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExecutablePath}" />
                                            <TextBlock Text="{Binding ExecutablePath}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExecutablePath}" />
                                        </StackPanel>

                                        <!-- 状态 -->
                                        <Border Grid.Column="2"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderThickness="1"
                                                CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#26171A" />
                                                    <Setter Property="BorderBrush" Value="#5A3035" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="#2E5B40" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 操作 -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Command="{Binding ToggleDefaultCommand}"
                                                    Content="{Binding DefaultActionText}"
                                                    ToolTip="默认版本仅在没有匹配工程版本时使用" />
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="删除"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="删除该手动路径记录，不会删除本机文件" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="24"
                            Background="{StaticResource SurfaceSunkenBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="尚未发现 Unity Editor"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击「添加 Unity.exe」，或在安装 Unity Hub 后点击「重新检测」。"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
