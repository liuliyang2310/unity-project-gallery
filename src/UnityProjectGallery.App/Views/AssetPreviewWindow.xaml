<Window x:Class="UnityProjectGallery.App.Views.AssetPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UnityProjectGallery.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Assets 预览"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0"
              Height="48"
              Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="&#xE8A9;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource AccentOnDarkBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Assets 预览"
                           Margin="10,0,0,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProjectName}"
                           Margin="10,0,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="7,3"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <TextBlock Text="模型 · 图片 · 音频"
                               FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Border>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.WindowClose}"
                    Height="48"
                    Click="OnCloseClicked"
                    ToolTip="关闭（Esc）"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE8BB;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="10" />
            </Button>

            <Border Grid.ColumnSpan="2"
                    Height="1"
                    Background="{StaticResource DividerBrush}"
                    VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧 Assets 资源列表 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,16,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Assets 资源"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AssetCountText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,9"
                            Padding="10,0"
                            Height="34"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Style="{StaticResource TextBox.Search}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11.5"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="搜索文件名或路径"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 类型筛选 -->
                    <ListBox Grid.Row="2"
                             Margin="0,0,0,9"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ChipBorder"
                                                    Padding="9,5"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding AssetsView}"
                             SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ItemBorder"
                                                    Padding="9,7"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindGlyph}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentOnDarkBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="9,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativePath}" />
                                        <TextBlock Text="{Binding RelativePath}"
                                                   Margin="0,2,0,0"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource AccentOnDarkBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SizeText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="4"
                               Text="仅扫描工程 Assets 目录。模型为静态预览，不加载动画或 Unity 材质。"
                               Margin="0,10,0,0"
                               FontSize="9.5"
                               LineHeight="14"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 右侧预览区域 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18,10"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentFileName}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Margin="8,0,0,0"
                                        Padding="6,2"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentKindText}"
                                               FontSize="9"
                                               Foreground="{StaticResource AccentOnDarkBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentFilePath}"
                                       Margin="0,3,0,0"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewSummary}"
                                       Margin="0,0,12,0"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Secondary}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding RevealAssetFolderCommand}"
                                    Visibility="{Binding CanRevealAssetFolder, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="在资源管理器中打开此文件所在的文件夹">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="10"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="所在文件夹" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenImageCommand}"
                                    Visibility="{Binding CanOpenImage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="打开大图" FontSize="10.5" />
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding RetryCommand}"
                                    Visibility="{Binding CanReloadPreview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="重新加载" FontSize="10.5" />
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}"
                                    Height="28"
                                    Padding="10,0"
                                    Click="OnResetCameraClicked"
                                    Visibility="{Binding IsModelSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="10"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="重置视角" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <controls:ModelViewport x:Name="ModelView"
                                            Scene="{Binding Scene}"
                                            Visibility="{Binding IsModelSelected, Converter={StaticResource BoolToVisibility}}" />

                    <Border Background="{StaticResource SurfaceSunkenBrush}"
                            Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,24,24"
                                                  ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FF0C1118">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,24,24" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FF111823">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,12,12" />
                                                            <RectangleGeometry Rect="12,12,12,12" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                            <Image Source="{Binding PreviewImageSource}"
                                   Stretch="Uniform"
                                   Margin="28"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <controls:AudioPreviewPlayer x:Name="AudioPlayer"
                                                 SourcePath="{Binding PreviewAudioPath}"
                                                 Visibility="{Binding IsAudioSelected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 正在扫描或加载 -->
                    <Border Background="#CC0C1119"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ProgressBar Width="180"
                                         Height="3"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource BorderBrush}"
                                         BorderThickness="0" />
                            <TextBlock Text="{Binding BusyText}"
                                       Margin="0,14,0,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 加载失败 -->
                    <Border Background="#E60A0D13"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="52"
                                    Height="52"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="18"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ErrorTitle}"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       LineHeight="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Height="30"
                                    Padding="14,0"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding RetryCommand}"
                                    Content="重新加载" />
                        </StackPanel>
                    </Border>

                    <!-- 当前筛选没有资源 -->
                    <Border Background="#E60A0D13"
                            Visibility="{Binding HasNoVisibleAssets, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="52"
                                    Height="52"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8A9;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="18"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="没有可预览的资源"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="仅扫描工程 Assets 目录。支持模型 glTF / GLB / OBJ / FBX、图片 PNG / JPG / BMP / GIF / TIFF / WebP、音频 WAV / MP3 / OGG / AIFF / FLAC / M4A。"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       LineHeight="18"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Style="{StaticResource Button.Secondary}"
                                    Height="30"
                                    Padding="14,0"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding RefreshCommand}"
                                    Content="重新扫描" />
                        </StackPanel>
                    </Border>

                    <!-- 已发现资源但尚未选中 -->
                    <Border Background="#E60A0D13"
                            Visibility="{Binding ShowSelectionHint, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="从左侧选择一个资源开始预览"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="18,9"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="1"
                                   Text="双击视口或按 R 重置模型视角 · 空格播放/暂停音频"
                                   Margin="16,0,0,0"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />
    </Grid>
</Window>
