<UserControl x:Class="UnityProjectGallery.App.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UnityProjectGallery.App.Controls"
             Background="Transparent"
             Focusable="False">

    <UserControl.Resources>
        <Style x:Key="SearchBoxBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题与主要操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding HeaderSubtitle}"
                           Margin="0,5,0,0"
                           Style="{StaticResource Text.PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="24,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}"
                        Margin="0,0,10,0"
                        Command="{Binding Scan.RescanCommand}"
                        ToolTip="重新扫描所有扫描源">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   Style="{StaticResource Text.Icon}"
                                   FontSize="12"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="重新扫描" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding Scan.AddScanRootCommand}"
                        ToolTip="添加扫描根目录，扫描过程不会修改原始工程">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   Style="{StaticResource Text.Icon}"
                                   FontSize="12"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="添加扫描目录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 扫描进度 / 阶段说明 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Border Padding="12,9"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding Scan.IsScanning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Style="{StaticResource ProgressBar.Scan}"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Scan.ScanMessage}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentOnDarkBrush}" />
                            <TextBlock Text="{Binding Scan.RootProgressText}"
                                       Margin="8,0,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Scan.CurrentDirectory}"
                                   Margin="0,3,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Scan.CurrentDirectory}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Scan.FoundText}"
                               Margin="0,0,16,0"
                               FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="3"
                            Style="{StaticResource Button.Secondary}"
                            Height="30"
                            Padding="12,0"
                            Command="{Binding Scan.CancelScanCommand}"
                            ToolTip="取消当前扫描">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;"
                                       Style="{StaticResource Text.Icon}"
                                       FontSize="10"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="取消扫描" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Padding="12,8"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding Scan.IsScanning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                ToolTip="{Binding Scan.ScanRootsToolTip}">
                        <TextBlock Text="&#xE8B7;"
                                   Style="{StaticResource Text.Icon}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Scan.ScanRootSummary}"
                                   Margin="6,0,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 搜索与排序 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchBox"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SearchBoxBorder}">
                <Grid>
                    <TextBlock Text="&#xE721;"
                               Style="{StaticResource Text.Icon}"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Left" />
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource TextBox.Search}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="38,0,36,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="搜索名称、路径、简介、标签或功能…"
                               Margin="40,0,36,0"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringVisibility}}" />
                    <Button Style="{StaticResource Button.Icon}"
                            Width="26"
                            Height="26"
                            Margin="0,0,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="清除搜索"
                            Visibility="{Binding SearchText, Converter={StaticResource StringVisibility}, ConverterParameter=NotEmpty}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ResultSummary}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="排序"
                           Margin="18,0,8,0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <ComboBox Style="{StaticResource ComboBox.Sort}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 分类筛选 -->
        <ItemsControl Grid.Row="3"
                      Margin="0,14,0,10"
                      ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource ToggleButton.Chip}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding Command}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Count}"
                                       Margin="7,0,0,0"
                                       FontSize="10"
                                       Opacity="0.65"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 工程卡片网格 -->
        <Grid Grid.Row="4" Margin="0,2,0,18">
            <ListBox ItemsSource="{Binding Projects}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,6,0"
                     HorizontalContentAlignment="Left"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemWidth="330"
                                                       ItemHeight="336"
                                                       ItemMargin="0,0,22,22" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Card}"
                                    Width="330"
                                    Height="336"
                                    Margin="0,0,22,22"
                                    Command="{Binding OpenCommand}"
                                    ToolTip="查看工程详情">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="168" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Border Background="{Binding Name, Converter={StaticResource CoverBrush}}"
                                                CornerRadius="15,15,0,0" />

                                        <Ellipse Width="150"
                                                 Height="150"
                                                 Margin="0,0,18,12"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Stroke="#33FFFFFF"
                                                 StrokeThickness="1" />
                                        <Ellipse Width="74"
                                                 Height="74"
                                                 Margin="0,0,48,38"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Stroke="#26FFFFFF"
                                                 StrokeThickness="1" />

                                        <TextBlock Text="{Binding Name, Converter={StaticResource ProjectInitial}}"
                                                   FontSize="58"
                                                   FontWeight="Bold"
                                                   Foreground="#E6FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.92" />

                                        <Image Source="{Binding CoverThumbnailPath, Converter={StaticResource ImagePath}, ConverterParameter=500}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <Border Margin="12"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource CoverChipBrush}"
                                                BorderBrush="{StaticResource CoverChipBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <TextBlock Text="{Binding UnityVersionDisplay}"
                                                       FontSize="10"
                                                       Foreground="#E8FFFFFF" />
                                        </Border>

                                        <ToggleButton Style="{StaticResource ToggleButton.Favorite}"
                                                      Margin="10"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                                      Command="{Binding ToggleFavoriteCommand}"
                                                      ToolTip="收藏 / 取消收藏" />

                                        <Border Margin="12"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Background="#CC26171A"
                                                BorderBrush="#5A3035"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding IsProjectPathMissing, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource DangerBrush}" />
                                                <TextBlock Text="路径失效"
                                                           Margin="4,0,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="16,0,16,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Name}"
                                                   Margin="0,14,0,0"
                                                   Style="{StaticResource Text.CardTitle}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DescriptionDisplay}"
                                                   Height="38"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />

                                        <ItemsControl Grid.Row="2"
                                                      Margin="0,8,0,0"
                                                      MaxHeight="23"
                                                      ClipToBounds="True"
                                                      ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Border.TagChip}"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Grid.Row="4"
                                                Padding="0,10,0,0"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE91B;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ScreenshotCount}"
                                                               Margin="4,0,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="&#xE714;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Margin="14,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VideoCount}"
                                                               Margin="4,0,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            ToolTip="最近扫描时间">
                                                    <TextBlock Text="&#xE72C;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="扫描于 "
                                                               Margin="4,0,0,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LastScanTime, Converter={StaticResource RelativeTime}}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,60">
                    <Border Width="64"
                            Height="64"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="24"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}"
                               Margin="0,16,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyDescription}"
                               Margin="0,6,0,0"
                               MaxWidth="420"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource Button.Primary}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding Scan.AddScanRootCommand}"
                            Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;"
                                       Style="{StaticResource Text.Icon}"
                                       FontSize="12"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="添加扫描目录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
