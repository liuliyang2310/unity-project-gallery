<Window x:Class="UnityProjectGallery.App.Views.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="素材预览"
        Width="1100"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#05070B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="48"
              Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TypeGlyph"
                           Text="&#xE91B;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource AccentOnDarkBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText"
                           Text="素材预览"
                           Margin="10,0,0,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="MetaText"
                           Margin="10,0,0,0"
                           FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Window}"
                    Height="48"
                    Click="OnToggleFullscreenClicked"
                    ToolTip="全屏 / 还原（F11）"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="FullscreenGlyph"
                           Text="&#xE740;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="11" />
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.WindowClose}"
                    Height="48"
                    Click="OnCloseClicked"
                    ToolTip="关闭（Esc）"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE8BB;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="10" />
            </Button>

            <Border Grid.ColumnSpan="3"
                    Height="1"
                    Background="{StaticResource DividerBrush}"
                    VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1" Background="#05070B">
            <Image x:Name="ImageViewer"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   Margin="0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          MediaOpened="OnMediaOpened"
                          MediaFailed="OnMediaFailed"
                          MediaEnded="OnMediaEnded" />

            <Border x:Name="MessageOverlay"
                    Visibility="Collapsed"
                    Background="#E6080B12">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="56"
                            Height="56"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="MessageText"
                               Margin="0,16,0,0"
                               MaxWidth="560"
                               FontSize="12.5"
                               LineHeight="20"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="VideoControls"
                Grid.Row="2"
                Padding="16,10"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource Button.Icon}"
                        Click="OnPlayPauseClicked"
                        ToolTip="播放 / 暂停（空格）">
                    <TextBlock x:Name="PlayGlyph"
                               Text="&#xE768;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12" />
                </Button>

                <TextBlock x:Name="PositionText"
                           Grid.Column="1"
                           Text="00:00"
                           Margin="10,0,0,0"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <Slider x:Name="PositionSlider"
                        Grid.Column="2"
                        Margin="14,0"
                        IsMoveToPointEnabled="True"
                        IsEnabled="False"
                        Style="{StaticResource Slider.Media}"
                        ValueChanged="OnPositionSliderValueChanged"
                        PreviewMouseLeftButtonDown="OnPositionSliderMouseDown"
                        PreviewMouseLeftButtonUp="OnPositionSliderMouseUp" />

                <TextBlock x:Name="DurationText"
                           Grid.Column="3"
                           Text="00:00"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="4"
                        Style="{StaticResource Button.Icon}"
                        Margin="10,0,0,0"
                        Click="OnToggleFullscreenClicked"
                        ToolTip="全屏 / 还原（F11）">
                    <TextBlock x:Name="VideoFullscreenGlyph"
                               Text="&#xE740;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />
    </Grid>
</Window>
