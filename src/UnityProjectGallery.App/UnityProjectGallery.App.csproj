<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.11.0-beta</Version>
    <Product>Unity Project Gallery</Product>
    <Description>本地 Unity 工程展示与管理工具（Beta）</Description>
    <ApplicationIcon>Assets\UnityProjectGallery.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityProjectGallery.Core\UnityProjectGallery.Core.csproj" />
    <ProjectReference Include="..\UnityProjectGallery.Infrastructure\UnityProjectGallery.Infrastructure.csproj" />
    <ProjectReference Include="..\UnityProjectGallery.Models\UnityProjectGallery.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UnityProjectGallery.ico" />
  </ItemGroup>

</Project>
