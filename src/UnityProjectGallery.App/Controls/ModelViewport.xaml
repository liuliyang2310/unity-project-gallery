<UserControl x:Class="UnityProjectGallery.App.Controls.ModelViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             ClipToBounds="True"
             Focusable="True"
             MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
             MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
             MouseRightButtonDown="OnViewportMouseRightButtonDown"
             MouseRightButtonUp="OnViewportMouseRightButtonUp"
             MouseMove="OnViewportMouseMove"
             MouseWheel="OnViewportMouseWheel"
             MouseDoubleClick="OnViewportMouseDoubleClick"
             LostMouseCapture="OnViewportLostMouseCapture">

    <Grid>
        <Border>
            <Border.Background>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,30,30"
                              ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#FF0C1119">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#141A24" Thickness="1" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="30,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,30" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <Viewport3D x:Name="Viewport" />

        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45">
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#7305070B" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <TextBlock Text="左键旋转 · 右键平移 · 滚轮缩放 · 双击重置"
                   Margin="16"
                   FontSize="10"
                   Foreground="#8A6F7B8F"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
