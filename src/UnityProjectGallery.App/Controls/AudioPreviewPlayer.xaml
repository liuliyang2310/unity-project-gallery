<UserControl x:Class="UnityProjectGallery.App.Controls.AudioPreviewPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             ClipToBounds="True"
             Unloaded="OnControlUnloaded">

    <Grid>
        <Border Background="{StaticResource SurfaceSunkenBrush}" />

        <Grid Margin="36,28,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560">
                <Border Width="92"
                        Height="92"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="46"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8D6;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="34"
                               Foreground="{StaticResource AccentOnDarkBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="FileText"
                           Text="音频预览"
                           Margin="0,18,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TypeText"
                           Text="选择音频文件后在此播放"
                           Margin="0,7,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border x:Name="ControlsPanel"
                    Grid.Row="1"
                    Padding="14,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Style="{StaticResource Button.Icon}"
                            Width="38"
                            Height="38"
                            IsEnabled="False"
                            Click="OnPlayPauseClicked"
                            ToolTip="播放 / 暂停（空格）">
                        <TextBlock x:Name="PlayGlyph"
                                   Text="&#xE768;"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13" />
                    </Button>

                    <TextBlock x:Name="PositionText"
                               Grid.Column="1"
                               Text="00:00"
                               Margin="12,0,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Slider x:Name="PositionSlider"
                            Grid.Column="2"
                            Margin="14,0"
                            IsMoveToPointEnabled="True"
                            IsEnabled="False"
                            Style="{StaticResource Slider.Media}"
                            ValueChanged="OnPositionSliderValueChanged"
                            PreviewMouseLeftButtonDown="OnPositionSliderMouseDown"
                            PreviewMouseLeftButtonUp="OnPositionSliderMouseUp" />

                    <TextBlock x:Name="DurationText"
                               Grid.Column="3"
                               Text="00:00"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ErrorPanel"
                Background="#E60A0D13"
                Visibility="Collapsed">
            <StackPanel MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="52"
                        Height="52"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="18"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="无法播放该音频"
                           Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           LineHeight="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
