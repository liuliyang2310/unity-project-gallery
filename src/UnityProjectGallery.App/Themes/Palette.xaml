<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础色板：统一深色桌面视觉规范 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0D13" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#0B0E15" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0C1017" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131926" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#18202E" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1E2736" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0E131C" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#F2151922" />
    <SolidColorBrush x:Key="BorderBrush" Color="#222B3A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#303B4E" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1A2230" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1C2431" />

    <!-- 文本色 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF1F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4C5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6F7B8F" />

    <!-- 强调色与状态色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6C8BFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#809BFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5A78EC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2542" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3E5BB8" />
    <SolidColorBrush x:Key="AccentOnDarkBrush" Color="#A9BCFF" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#FFC65C" />
    <SolidColorBrush x:Key="FavoriteSoftBrush" Color="#3D3118" />
    <SolidColorBrush x:Key="FavoriteBorderBrush" Color="#6B5727" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#172B21" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <!-- 控件专用色 -->
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#1A2130" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2B3445" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#3B4A63" />
    <SolidColorBrush x:Key="CoverChipBrush" Color="#B30A0E16" />
    <SolidColorBrush x:Key="CoverChipBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TagChipBackgroundBrush" Color="#1A2230" />
    <SolidColorBrush x:Key="TagChipBorderBrush" Color="#2A3446" />
    <SolidColorBrush x:Key="HeroChipBorderBrush" Color="#33FFFFFF" />

    <!-- 渐变 -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D8BFF" Offset="0" />
        <GradientStop Color="#A46BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CoverShadeBrush" StartPoint="0.5,0.25" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#9905070B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroShadeBrush" StartPoint="0.5,0.35" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#B305070B" Offset="1" />
    </LinearGradientBrush>

    <!-- 字体 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- 圆角规范 -->
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
